{
  "manifest_version": 3,
  "name": "SnelStart Batch Upload",
  "version": "1.0.0",
  "description": "Batch-upload receipts to SnelStart with optional Claude Vision pre-check. Select a folder of 50+ images and let them queue automatically.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["*://*.snelstart.nl/*"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.snelstart.nl/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "action": {
    "default_title": "SnelStart Batch Upload",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
